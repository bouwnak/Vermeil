      "title": "Chocolate Chip Cookies",
      "servings": 24,
      "source": "",
      "ingredients": [
        {
          "qty": 2.5,
          "unit": "cup",
          "name": "all-purpose flour",
          "text": "2 1/2 cups all-purpose flour",
          "id": "e7621b"
        },
        {
          "qty": 1.0,
          "unit": "cup",
          "name": "softened butter",
          "text": "1 cup softened butter",
          "id": "932d5c"
        },
        {
          "qty": 0.5,
          "unit": "cup",
          "name": "white sugar",
          "text": "1/2 cup white sugar",
