# Vermeil Environment Configuration Template
# Copy this file to 'env' (or '.env') in the project root and fill in your keys.
# NEVER commit your actual 'env' file to version control.

# --- Core AI (Online & Avatar Creator) ---
# Groq API key for online conversational AI and multimodal Avatar photo vision analysis
# Free tier available at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key (optional alternative for multimodal Avatar photo vision analysis)
# https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# --- Weather ---
# OpenWeatherMap API key (https://openweathermap.org/api)
# Leave blank to use wttr.in fallback without a key
WEATHER_API_KEY=your_weather_api_key_here

# --- Audio & Microphone ---
# Optional: index of the microphone device (leave blank for system default)
MIC_INDEX=

# --- Spotify Integration (Optional, requires Spotify Premium) ---
# Create an app at https://developer.spotify.com/dashboard
# Set redirect URI to: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Voice & Kokoro TTS (Optional) ---
# KOKORO_AUTOSTART=1
# KOKORO_MODEL_DIR=tools/kokoro
# ONNX_PROVIDER=CPUExecutionProvider  # or CUDAExecutionProvider for NVIDIA GPU
# KOKORO_URL=
